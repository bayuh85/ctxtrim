# OpenAI-compatible provider. These are the defaults when unset.
CTXTRIM_BASE_URL=https://atmorouter.dev/v1
CTXTRIM_API_KEY=
CTXTRIM_MODEL=zai/glm-5.3

# Where session notes and the gloss cache are stored. Default: ~/.ctxtrim
# CTXTRIM_HOME=

# Inputs at or below this size are returned as-is (ANSI stripped). Default: 2000
# CTXTRIM_PASSTHROUGH_CHARS=2000

# After the mechanical press, gloss with the model when the text is still
# at least this long and CTXTRIM_API_KEY is set. Default: 3500
# CTXTRIM_GLOSS_THRESHOLD=3500

# Character budget asked of the model. Default: 1800
# CTXTRIM_TARGET_CHARS=1800

# Hard cap on the mechanical press, which is also the model input. Default: 12000
# CTXTRIM_PRESS_CHARS=12000

# Provider timeout in milliseconds. Default: 60000
# CTXTRIM_TIMEOUT_MS=60000

# Character budget for active session notes. Older notes roll into a digest. Default: 4000
# CTXTRIM_NOTE_BUDGET=4000
