{
  "name": "ctxtrim",
  "version": "0.1.0",
  "description": "CLI and MCP server that shrinks coding-agent context by trimming and summarizing large tool output.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "ctxtrim": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "node --import tsx --test test/*.test.ts",
    "dev": "tsx src/cli.ts"
  },
  "keywords": [
    "mcp",
    "cli",
    "context",
    "coding-agent",
    "llm"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
